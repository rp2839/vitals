// Merge this module section into ~/.config/waybar/config.jsonc
// and add "custom/vitals-battery" to your modules-right list.
//
// NOTE (this machine's waybar 0.15): do NOT set "interval" — the bridge
// streams JSON lines continuously (one object per line).
{
  "custom/vitals-battery": {
    "exec": "~/.local/bin/vitals-bar battery",
    "return-type": "json",
    "restart-interval": 3,
    "exec-on-event": false,
    "on-click": "~/.local/bin/vitalsctl panel toggle",
    "on-click-right": "~/.local/bin/vitalsctl profile cycle",
    "on-scroll-up": "~/.local/bin/vitalsctl brightness +5",
    "on-scroll-down": "~/.local/bin/vitalsctl brightness -5",
    "tooltip": true
  },
  // Replaces waybar's built-in "bluetooth" module; add
  // "custom/vitals-bluetooth" to modules-right. Left click will open the
  // Bluetooth panel once it lands; right click toggles adapter power.
  "custom/vitals-bluetooth": {
    "exec": "~/.local/bin/vitals-bar bluetooth",
    "return-type": "json",
    "restart-interval": 3,
    "exec-on-event": false,
    "on-click-right": "~/.local/bin/vitalsctl bluetooth power toggle",
    "tooltip": true
  }
}
